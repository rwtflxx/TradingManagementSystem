@model TradingManagementSystem.Web.Controllers.DashboardStats
@{ ViewData["Title"] = "Головна"; }
<div class="sf-dashboard-intro">
    <div>
        <span class="eyebrow">ОГЛЯД СИСТЕМИ</span>
        <h1>Панель керування</h1>
        <p>Усі ключові показники торгової організації — в одному місці.</p>
    </div>
    <span class="sf-live-chip"><span class="sf-live-dot"></span> Дані з MongoDB</span>
</div>
<div class="stats-grid">
    <a class="stat-card sf-stat-products" asp-controller="Catalog" asp-action="Products">
        <span class="sf-stat-top"><span>Товари</span><span class="sf-stat-icon" aria-hidden="true">▣</span></span>
        <strong>@Model.Products</strong><small>У каталозі продукції</small><span class="sf-stat-more">Переглянути каталог →</span>
    </a>
    <a class="stat-card sf-stat-stores" asp-controller="Catalog" asp-action="TradingPoints">
        <span class="sf-stat-top"><span>Торгові точки</span><span class="sf-stat-icon" aria-hidden="true">⌂</span></span>
        <strong>@Model.TradingPoints</strong><small>Філії та магазини</small><span class="sf-stat-more">Переглянути точки →</span>
    </a>
    <a class="stat-card sf-stat-alerts" asp-controller="Catalog" asp-action="Inventory">
        <span class="sf-stat-top"><span>Низькі залишки</span><span class="sf-stat-icon" aria-hidden="true">!</span></span>
        <strong class="accent-number">@Model.LowStock</strong><small>Позиції, що потребують уваги</small><span class="sf-stat-more">Переглянути залишки →</span>
    </a>
    <a class="stat-card sf-stat-sales" asp-controller="Catalog" asp-action="Sales">
        <span class="sf-stat-top"><span>Продажі</span><span class="sf-stat-icon" aria-hidden="true">↗</span></span>
        <strong>@Model.Sales</strong><small>Зареєстровані операції</small><span class="sf-stat-more">Історія продажів →</span>
    </a>
</div>
<div class="panel-grid sf-dashboard-panels">
    <section class="content-card sf-operations-panel">
        <span class="eyebrow">ОСНОВНИЙ ПРОЦЕС</span>
        <h2>Як працює StockFlow</h2>
        <p>Закупівля фіксує замовлення, надходження додає товар на склад, а продаж автоматично списує його із залишків.</p>
        <div class="sf-process-steps">
            <div class="sf-process-step"><span>01</span><strong>Закупівля</strong><small>Створення замовлення</small></div>
            <div class="sf-process-step"><span>02</span><strong>Надходження</strong><small>Оприбуткування товару</small></div>
            <div class="sf-process-step"><span>03</span><strong>Продаж</strong><small>Оновлення залишку</small></div>
        </div>
    </section>
    <section class="content-card sf-upcoming-panel">
        <span class="eyebrow">МОЖЛИВОСТІ СИСТЕМИ</span>
        <h2>Керування торговою організацією</h2>
        <p>Товари, постачальники, торгові точки та облік операцій доступні в єдиному робочому просторі.</p>
        <div class="sf-feature-list">
            <div><span class="sf-feature-dot"></span> Облік закупівель і надходжень</div>
            <div><span class="sf-feature-dot"></span> Реєстрація продажів</div>
            <div><span class="sf-feature-dot"></span> Контроль товарних залишків</div>
        </div>
        <p class="note">Вебформи торгових операцій та Smart Inventory ще розробляються. API доступне в Swagger.</p>
        <a class="text-link" href="/swagger">Відкрити Swagger →</a>
    </section>
</div>
