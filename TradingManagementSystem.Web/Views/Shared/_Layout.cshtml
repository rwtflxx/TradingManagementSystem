@using System.Security.Claims
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#15342f" />
    <title>@ViewData["Title"] · StockFlow</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/stockflow-themes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/stockflow-refresh.css" asp-append-version="true" />
    <script>
        (function () {
            var theme = 'mixed';
            try { var saved = localStorage.getItem('stockflow.theme.v1'); if (['mixed', 'light', 'dark'].indexOf(saved) !== -1) theme = saved; } catch (_) { }
            document.documentElement.setAttribute('data-sf-theme', theme);
        })();
    </script>
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="app-shell">
        <aside class="sidebar" aria-label="Бічне меню StockFlow">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="StockFlow — головна">
                <span class="brand-icon" aria-hidden="true">S<span class="brand-icon-dot">.</span></span>
                <span class="brand-wordmark">StockFlow<small>РОЗУМНЕ УПРАВЛІННЯ ТОРГІВЛЕЮ</small></span>
            </a>
            <nav class="side-nav" aria-label="Основна навігація">
                <span class="nav-section-label">ОГЛЯД</span>
                <a asp-controller="Home" asp-action="Index"><span class="sf-nav-icon" aria-hidden="true">▦</span><span>Головна</span></a>
                <span class="nav-section-label">УПРАВЛІННЯ</span>
                <a asp-controller="Catalog" asp-action="Products"><span class="sf-nav-icon" aria-hidden="true">◫</span><span>Товари</span></a>
                @if (!User.IsInRole("Seller"))
                { <a asp-controller="Catalog" asp-action="Suppliers"><span class="sf-nav-icon" aria-hidden="true">◇</span><span>Постачальники</span></a> }
                <a asp-controller="Catalog" asp-action="TradingPoints"><span class="sf-nav-icon" aria-hidden="true">⌂</span><span>Торгові точки</span></a>
                @if (User.IsInRole("Director") || User.IsInRole("SupplyManager"))
                {
                    <a asp-controller="Catalog" asp-action="Purchases"><span class="sf-nav-icon" aria-hidden="true">▤</span><span>Закупівлі</span></a>
                    <a asp-controller="Catalog" asp-action="Receipts"><span class="sf-nav-icon" aria-hidden="true">↧</span><span>Надходження</span></a>
                }
                @if (User.IsInRole("Director") || User.IsInRole("TradingPointManager") || User.IsInRole("Seller"))
                { <a asp-controller="Catalog" asp-action="Sales"><span class="sf-nav-icon" aria-hidden="true">◈</span><span>Продажі</span></a> }
                <a asp-controller="Catalog" asp-action="Inventory"><span class="sf-nav-icon" aria-hidden="true">▥</span><span>Залишки</span></a>
                @if (User.IsInRole("Director"))
                {
                    <span class="nav-section-label">АДМІНІСТРУВАННЯ</span>
                    <a asp-controller="Employees" asp-action="Index"><span class="sf-nav-icon" aria-hidden="true">♙</span><span>Працівники</span></a>
                }
            </nav>
            <div class="side-bottom">
                <a asp-controller="Profile" asp-action="Index"><span class="sf-nav-icon" aria-hidden="true">⚙</span><span>Мій профіль</span></a>
                <div class="sidebar-caption">StockFlow · Система управління</div>
            </div>
        </aside>
        <div class="workspace">
            <header class="topbar">
                <div class="topbar-heading">
                    <span class="topbar-kicker">StockFlow / Робочий простір</span>
                    <span class="topbar-title">@ViewData["Title"]</span>
                </div>
                <div class="topbar-actions">
                    <button class="theme-cycle" type="button" data-sf-theme-cycle aria-label="Змінити тему" title="Перемкнути тему">
                        <span class="theme-cycle-icon" data-sf-theme-icon aria-hidden="true">◐</span>
                        <span class="theme-cycle-label" data-sf-theme-label>Комбінована</span>
                    </button>
                    <a class="profile-shortcut" asp-controller="Profile" asp-action="Index" title="Відкрити профіль">
                        <span class="profile-avatar" aria-hidden="true">@((User.Identity?.Name ?? "S").Substring(0, 1).ToUpperInvariant())</span>
                        <span class="profile-shortcut-text"><strong>@User.Identity?.Name</strong><small>@User.FindFirstValue(ClaimTypes.Role)</small></span>
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="topbar-logout"><button type="submit" class="logout-btn">Вийти</button></form>
                </div>
            </header>
            <main class="page-content">
                @if (TempData["Flash"] is string notice) { <div class="flash" role="status">@notice</div> }
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <div class="auth-shell">
        <div class="auth-theme-switch">
            <button class="theme-cycle" type="button" data-sf-theme-cycle aria-label="Змінити тему" title="Перемкнути тему">
                <span class="theme-cycle-icon" data-sf-theme-icon aria-hidden="true">◐</span>
                <span class="theme-cycle-label" data-sf-theme-label>Комбінована</span>
            </button>
        </div>
        <main class="auth-main">@RenderBody()</main>
    </div>
}
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/stockflow-theme.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
