@model List<TradingManagementSystem.Domain.Entities.Receipt>
@{ ViewData["Title"] = "Надходження"; }
<div class="page-heading"><div><span class="eyebrow">СКЛАД</span><h1>Надходження товарів</h1><p>Зареєстровані фактичні надходження</p></div>@if(User.IsInRole("SupplyManager")){<a class="primary-btn" asp-controller="Commerce" asp-action="RegisterReceipt" style="text-decoration:none">+ Реєструвати надходження</a>}</div>
<div class="table-card"><div class="sf-table-scroll"><table class="data-table"><thead><tr><th>Номер</th><th>Закупівля</th><th>Дата</th><th>Статус</th></tr></thead><tbody>
@foreach(var r in Model.OrderByDescending(x => x.ReceivedAt)) {<tr><td title="@r.Id">@(r.Id.Length>8?r.Id.Substring(0,8):r.Id)</td><td title="@r.PurchaseId">@(r.PurchaseId.Length>8?r.PurchaseId.Substring(0,8):r.PurchaseId)</td><td>@r.ReceivedAt.ToLocalTime().ToString("dd.MM.yyyy")</td><td>@(r.IsRegistered ? "Оприбутковано" : "Очікує")</td></tr>}
@if(Model.Count==0){<tr><td colspan="4">Надходжень поки немає.</td></tr>}
</tbody></table></div></div>
