@model List<TradingManagementSystem.Domain.Entities.Purchase>
@using TradingManagementSystem.Domain.Enums
@{ ViewData["Title"] = "Закупівлі"; }
<div class="page-heading"><div><span class="eyebrow">ЗАКУПІВЛІ</span><h1>Замовлення постачальникам</h1><p>Історія закупівель та фактичних надходжень</p></div>@if(User.IsInRole("SupplyManager")){<a class="primary-btn" asp-controller="Commerce" asp-action="NewPurchase" style="text-decoration:none">+ Нова закупівля</a>}</div>
<div class="table-card"><div class="sf-table-scroll"><table class="data-table"><thead><tr><th>Номер</th><th>Дата</th><th>Статус</th><th>Позицій</th><th>Сума, грн</th><th>Дія</th></tr></thead><tbody>
@foreach(var p in Model.OrderByDescending(x => x.CreatedAt)) {
<tr><td title="@p.Id"><strong>@(p.Id.Length > 8 ? p.Id.Substring(0,8) : p.Id)</strong></td><td>@p.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td><td>@(p.Status==PurchaseStatus.Received?"Отримано":p.Status==PurchaseStatus.Cancelled?"Скасовано":p.Status==PurchaseStatus.Ordered?"Замовлено":"Створено")</td><td>@p.Items.Count</td><td>@p.TotalAmount.ToString("0.00")</td><td>@if(User.IsInRole("SupplyManager") && p.Status!=PurchaseStatus.Received && p.Status!=PurchaseStatus.Cancelled){<a class="subtle-btn" asp-controller="Commerce" asp-action="RegisterReceipt" asp-route-purchaseId="@p.Id" style="text-decoration:none">Прийняти товар →</a>} else {<span>—</span>}</td></tr>
}
@if(Model.Count==0){<tr><td colspan="6">Закупівель поки немає.</td></tr>}
</tbody></table></div></div>
